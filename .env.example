PORT=5000
DB_USER=
DB_PASSWORD=

# Exact frontend origin. Used for CORS and to fetch /api/auth/jwks.
# In production, allow multiple origins by separating them with commas.
FRONTEND_URL=http://localhost:3000

# Must exactly match the frontend BETTER_AUTH_URL / JWT issuer.
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=mentorlagbe-express
